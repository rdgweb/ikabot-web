# =============================================================================
# ikabot-web - variáveis de ambiente
# =============================================================================
# O jeito fácil é rodar ./install.sh (Linux) ou .\install.ps1 (Windows): ele cria o
# .env a partir deste arquivo, com senhas aleatórias e o modo de acesso escolhido.
#
# À mão: copie para .env e preencha TODAS as linhas marcadas OBRIGATÓRIO. O compose
# se recusa a subir com elas vazias - de propósito, para nunca subir com senha conhecida.
# Para gerar uma senha: openssl rand -hex 32
# =============================================================================

# -- Segredos (OBRIGATÓRIO) ---------------------------------------------------
DJANGO_SECRET_KEY=
APP_SECRET=
AGENT_TOKEN=
# Chave do próprio nó do agente desta máquina (Nós & Agents → Gerar nova chave). Vazia = usa AGENT_TOKEN.
AGENT_NODE_TOKEN=
# false = a chave única acima deixa de abrir a API do agente (cada agente com a chave do seu nó).
AGENT_SHARED_TOKEN_ENABLED=true
MYSQL_ROOT_PASSWORD=
DB_PASSWORD=
REDIS_PASSWORD=

# -- Administrador ------------------------------------------------------------
# Criado na primeira subida com esta senha (OBRIGATÓRIO). Depois vale a senha trocada
# pela tela; ADMIN_RESET_PASSWORD=true força esta de novo no próximo início.
ADMIN_USERNAME=admin
ADMIN_EMAIL=admin@ikabot.local
ADMIN_PASSWORD=
ADMIN_RESET_PASSWORD=false

# -- Acesso -------------------------------------------------------------------
# Endereço pelo qual o hub é aberto no navegador:
#   direto pela rede:          http://192.168.0.10:8000
#   com domínio (proxy):       https://ikabot.seudominio.com   (ou http:// sem certificado)
# Dele saem o host aceito e a origem do login; as duas linhas abaixo só precisam
# ser preenchidas para aceitar mais de um endereço (separados por vírgula).
HUB_PUBLIC_URL=
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,hub
DJANGO_CSRF_TRUSTED_ORIGINS=

# Porta do hub nesta máquina e em que interface ela escuta (0.0.0.0 = rede toda;
# com o Nginx Proxy Manager na frente use 127.0.0.1).
HUB_PORT=8000
HUB_BIND=0.0.0.0

# Perfis opcionais, separados por vírgula: proxy (Nginx Proxy Manager), tools (phpMyAdmin),
# telegram (Telegram sem HTTPS: busca as mensagens em vez de esperar o webhook),
# stats (Umami: visitas do site público)
COMPOSE_PROFILES=

# Nginx Proxy Manager (perfil proxy): portas públicas e o painel de configuração.
# PROXY_HTTP_PORT=80
# PROXY_HTTPS_PORT=443
# PROXY_ADMIN_PORT=81
# PROXY_ADMIN_BIND=0.0.0.0

# -- Site público (N-119) ------------------------------------------------------
# Páginas de venda, preços, FAQ e termos em /pt/ e /en/. SITE_URL é o endereço publicado
# (vazio = HUB_PUBLIC_URL). SITE_INDEXABLE=true deixa o Google indexar o site (o painel nunca).
# SITE_URL=https://ikahub.com
# SITE_INDEXABLE=false
# Quem responde nos termos e na privacidade; cada item só aparece se preenchido.
# SITE_LEGAL_NAME=
# SITE_LEGAL_DOCUMENT=
# SITE_LEGAL_CITY=
# SITE_CONTACT_EMAIL=
# SITE_PRIVACY_EMAIL=
# SITE_CONTACT_TELEGRAM=
# Estatística (perfil stats): senhas do Umami e o id do site criado nele.
# UMAMI_DB_PASSWORD=
# UMAMI_APP_SECRET=
# UMAMI_URL=http://umami:3000
# UMAMI_WEBSITE_ID=

# -- Cobrança (N-124) -----------------------------------------------------------
# Chave da API do Asaas (Minha conta > Integrações). Comece com a do sandbox; produção só
# com ASAAS_SANDBOX=false. O token do webhook (32+ caracteres) é conferido em cada aviso;
# depois de preenchidos: docker compose exec hub python manage.py asaas_webhook
# ASAAS_API_KEY=
# ASAAS_SANDBOX=true
# ASAAS_WEBHOOK_TOKEN=

# -- E-mail e cadastro aberto (N-125) ---------------------------------------------
# SMTP da sua conta (Gmail: smtp.gmail.com, Zoho: smtp.zoho.com) com senha de app.
# Porta 587 (STARTTLS) ou 465 (SSL). Sem SMTP, o cadastro aberto e o "esqueci a senha" não ligam.
# EMAIL_HOST=
# EMAIL_PORT=587
# EMAIL_HOST_USER=
# EMAIL_HOST_PASSWORD=
# EMAIL_FROM=IkaHub <voce@seudominio.com>
# SIGNUP_OPEN=false

# -- Agente da plataforma (N-131) ---------------------------------------------------
# Id do Host Docker (Nós & Agents > Hosts Docker) cujo supervisor (0.2.0+) cria os agentes dos
# clientes; vazio = o adicional não aparece. Teto de agentes e memória de cada um.
# PLATFORM_AGENT_HOST_ID=
# PLATFORM_AGENT_LIMIT=10
# PLATFORM_AGENT_MEMORY_MB=256

# -- Controle manual (opcional, exige domínio) --------------------------------
# Cada sessão do jogo aberta pelo painel é servida em <token>.<este domínio>; o proxy
# precisa de um host curinga (*.jogo.seudominio.com) apontando para a porta do gateway.
# Vazio = recurso desligado. Veja docs/proxy.md.
MANUAL_GATEWAY_DOMAIN=
MANUAL_GATEWAY_SCHEME=https
# GATEWAY_PORT=8001
# GATEWAY_BIND=0.0.0.0

# -- Banco (MariaDB) e Redis --------------------------------------------------
DB_NAME=ikabot_hub
DB_USER=ikabot
# Só nesta máquina por padrão. Agentes em outra máquina precisam do Redis:
# REDIS_BIND=0.0.0.0 (e a senha acima forte).
# DB_BIND=127.0.0.1
# DB_PORT=3306
# REDIS_BIND=127.0.0.1
# REDIS_PORT=6379

# -- Agente (container agent) -------------------------------------------------
HUB_URL=http://hub:8000
# Id fixo do nó deste agente (OBRIGATÓRIO; o instalador gera). À mão: uuidgen
AGENT_NODE_ID=
AGENT_NAME=ikabot-agent-01

# -- IkabotAPI (obrigatório, já vem no compose) -------------------------------
# Gera o token de login e resolve captchas. Só mude se rodar em outro lugar.
IKABOTAPI_URL=http://ikabotapi:5005
# IKABOTAPI_IMAGE=blackoneal/ikabot-web-ikabotapi:fb87efe
# IKABOTAPI_BIND=127.0.0.1

# -- Supervisor (perfil supervisor, opcional) ---------------------------------
# Nós & Agents > Docker Hosts: cadastre esta máquina e copie o id e o token.
SUPERVISOR_HOST_ID=
SUPERVISOR_HOST_TOKEN=

# -- Outros -------------------------------------------------------------------
TZ=America/Sao_Paulo
WEBSHARE_API_KEY=
HUB_IMAGE=blackoneal/ikabot-web-hub:latest
AGENT_IMAGE=blackoneal/ikabot-web-agent:latest
# PMA_PORT=8080
