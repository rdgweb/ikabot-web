# =============================================================================
# ikabot-web - Environment Variables
# =============================================================================
# 1. Copy this file to .env
# 2. Change at least the values marked REQUIRED
# 3. Start the stack with: docker compose up -d --build
# =============================================================================

# -- Django / Hub -------------------------------------------------------------
DJANGO_SECRET_KEY=change-me-to-a-long-random-string
DJANGO_DEBUG=false
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# -- Initial admin user -------------------------------------------------------
ADMIN_CREATE=true
ADMIN_USERNAME=admin
ADMIN_EMAIL=admin@ikabot.local
ADMIN_PASSWORD=change-me-admin-password

# -- Database (MariaDB) -------------------------------------------------------
DB_NAME=ikabot_hub
DB_USER=ikabot
DB_PASSWORD=change-me-db-password
DB_HOST=mariadb
DB_PORT=3306
MYSQL_ROOT_PASSWORD=change-me-root-password

# -- Redis --------------------------------------------------------------------
REDIS_PASSWORD=change-me-redis-password
REDIS_URL=redis://:change-me-redis-password@redis:6379/0

# -- Shared secrets -----------------------------------------------------------
# APP_SECRET should be a stable application secret used by the hub.
APP_SECRET=change-me-app-secret
AGENT_TOKEN=change-me-agent-token

# -- Optional services --------------------------------------------------------
WEBSHARE_API_KEY=

# IkabotAPI is an external dependency, not bundled in this repository.
# Point this to an existing IkabotAPI instance if you want captcha/token features.
# Example when self-hosted separately: http://ikabotapi:5005
IKABOTAPI_URL=

# -- Agent (agent_v2 container) -----------------------------------------------
HUB_URL=http://hub:8000
AGENT_NODE_ID=
AGENT_NAME=ikabot-agent-01

# -- Optional Docker image tags -----------------------------------------------
HUB_IMAGE=blackoneal/ikabot-web-hub:latest
AGENT_IMAGE=blackoneal/ikabot-web-agent:latest

# -- Optional port overrides --------------------------------------------------
# HUB_PORT=8000
# DB_PORT=3306
# REDIS_PORT=6379
# PMA_PORT=8080
