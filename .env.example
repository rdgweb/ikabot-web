# =============================================================================
# ikabot-web  —  Environment Variables
# =============================================================================
# Copy this file:  cp .env.example .env
# Then edit the values below.
# =============================================================================

# -- Django -------------------------------------------------------------------
DJANGO_SECRET_KEY=change-me-to-random-string
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# -- Database (MariaDB) ------------------------------------------------------
DB_NAME=ikabot_hub
DB_USER=ikabot
DB_PASSWORD=change-me
DB_HOST=mariadb
DB_PORT=3306
MYSQL_ROOT_PASSWORD=change-me-root

# -- Redis --------------------------------------------------------------------
REDIS_URL=redis://redis:6379/0

# -- App Secrets --------------------------------------------------------------
APP_SECRET=change-me-32-char-fernet-key
AGENT_TOKEN=change-me-agent-token

# -- Webshare.io Proxy -------------------------------------------------------
WEBSHARE_API_KEY=

# -- ikabotapi (captcha solver) -----------------------------------------------
IKABOTAPI_URL=http://ikabotapi:8888

# -- Agent (agent_v2 container) -----------------------------------------------
HUB_URL=http://hub:8000
AGENT_NODE_ID=
AGENT_NAME=ikabot-agent-01

# -- phpMyAdmin ---------------------------------------------------------------
PMA_HOST=mariadb

# -- Port overrides (optional) ------------------------------------------------
# HUB_PORT=8000
# DB_PORT=3306
# REDIS_PORT=6379
# PMA_PORT=8080
# IKABOTAPI_PORT=8888
