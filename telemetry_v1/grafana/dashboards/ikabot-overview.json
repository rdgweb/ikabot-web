     },
     "editorMode": "code",
     "format": "table",
     "rawQuery": true,
     "rawSql": "SELECT u.category AS \"Categoria\", sum(u.jobs) AS \"Jobs\", count(DISTINCT u.install_id) AS \"Instalações\" FROM ping_usage u JOIN installs i ON i.install_id = u.install_id AND u.day = i.last_seen WHERE i.last_seen >= current_date - 30 GROUP BY 1 ORDER BY 2 DESC",
     "refId": "A"
    }
   ],
